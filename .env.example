# Copy to .env (gitignored) and fill in. Loaded and validated at startup by src/config/env.ts; variables already set
# in the environment win.
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=osrs-tracker
OSRS_API_BASE_URL=https://runescape-api.freekmencke.com/rs

# Optional (empty means the default)
CORS_ORIGIN=
PORT=3000
METRICS_PORT=9090
NODE_ENV=
