# Copy to .env (gitignored) and fill in. Loaded and validated at startup by src/config/env.ts; variables already set
# in the environment win.
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=osrs-tracker
OSRS_API_BASE_URL=https://runescape-api.freekmencke.com/rs

# Optional (empty means the default)
CORS_ORIGIN=
PORT=3000
METRICS_PORT=9090

# The ingester only (`npm run start:ingest`, src/config/env.ts `validateIngesterEnv`): the cluster's
# `osrs-tracker-ingester` Secret. Its AWS key only works from the server's IP. It reads the MONGODB_* values above (in
# the cluster that Secret overrides the user with its own, osrs-tracker-ingester), and METRICS_PORT.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SCRAPE_RESULTS_QUEUE_URL=
WEBHOOK_URL=
