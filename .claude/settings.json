{
  "permissions": {
    "ask": [
      "mcp__mongodb__insert-many",
      "mcp__mongodb__update-many",
      "mcp__mongodb__delete-many",
      "mcp__mongodb__create-index",
      "mcp__mongodb__drop-index",
      "mcp__mongodb__rename-collection",
      "mcp__mongodb__create-collection",
      "mcp__mongodb__drop-collection",
      "mcp__mongodb__drop-database"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*) \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/prettier --write --ignore-unknown \"$f\" >/dev/null 2>&1 ;; esac; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-check.sh",
            "timeout": 300,
            "statusMessage": "Running lint and prettier check before push"
          }
        ]
      }
    ]
  }
}
