{
  "name": "osrs-tracker-api",
  "version": "0.1.0",
  "private": true,
  "description": "This repository contains the NestJS API for OSRS Tracker.",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Freek Mencke",
    "email": "freek_mencke.dev@outlook.com",
    "url": "https://freekmencke.com"
  },
  "repository": {
    "type": "git",
    "url": "github:osrs-tracker/osrs-tracker-api"
  },
  "scripts": {
    "build": "NODE_ENV=production nest build -b rspack",
    "prettier": "prettier --write \"src/**/*.ts\" \"**/*.md\"",
    "prettier:ci": "prettier --check \"src/**/*.ts\" \"**/*.md\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:ingest": "nest start --entryFile ingest",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1154.0",
    "@aws-sdk/client-sqs": "^3.1154.0",
    "@aws-sdk/lib-dynamodb": "^3.1154.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/resilience": "0.0.2",
    "@nestjs/schedule": "^12.0.2",
    "@osrs-tracker/express-metrics": "^0.2.0",
    "@osrs-tracker/hiscores": "^6.0.0",
    "@osrs-tracker/logger": "^0.3.0",
    "@osrs-tracker/models": "^3.3.0",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "isbot": "^5.2.2",
    "leven": "^4.1.0",
    "lru-cache": "^11.5.3",
    "mongodb": "^7.5.0",
    "nestjs-cls": "^7.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "undici": "^8.12.1"
  },
  "devDependencies": {
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@rspack/core": "^2.2.9",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.10",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "webpack-node-externals": "^3.0.0"
  }
}
