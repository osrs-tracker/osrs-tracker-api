{
  "name": "osrs-tracker-api",
  "version": "0.1.0",
  "private": true,
  "description": "This repository contains the NestJS API for OSRS Tracker.",
  "license": "Apache-2.0",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "author": {
    "name": "Freek Mencke",
    "email": "freek_mencke.dev@outlook.com",
    "url": "https://freekmencke.com"
  },
  "repository": {
    "type": "git",
    "url": "github:osrs-tracker/osrs-tracker-api"
  },
  "scripts": {
    "build": "NODE_ENV=production nest build -b webpack",
    "docker:build": "docker build -t freekmencke/osrs-tracker-api:latest .",
    "docker:push": "docker push freekmencke/osrs-tracker-api:latest",
    "prettier": "prettier --write \"src/**/*.ts\"",
    "prettier:ci": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@osrs-tracker/models": "^0.6.0",
    "commitizen": "^4.3.2",
    "date-fns": "^4.4.0",
    "express-prom-bundle": "^8.0.0",
    "fast-xml-parser": "^5.10.1",
    "mongodb": "^7.5.0",
    "morgan": "^1.11.0",
    "node-fetch": "^3.3.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "@swc/core@1.15.46": true
  }
}
