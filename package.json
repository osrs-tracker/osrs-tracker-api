{
  "name": "osrs-tracker-api",
  "version": "0.1.0",
  "private": true,
  "description": "This repository contains the NestJS API for OSRS Tracker.",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=26"
  },
  "author": {
    "name": "Freek Mencke",
    "email": "freek_mencke.dev@outlook.com",
    "url": "https://freekmencke.com"
  },
  "repository": {
    "type": "git",
    "url": "github:osrs-tracker/osrs-tracker-api"
  },
  "scripts": {
    "build": "NODE_ENV=production nest build -b rspack",
    "prettier": "prettier --write \"src/**/*.ts\" \"**/*.md\"",
    "prettier:ci": "prettier --check \"src/**/*.ts\" \"**/*.md\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:ingest": "nest start --entryFile ingest",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\"",
    "knip": "knip",
    "jscpd": "jscpd"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1162.0",
    "@aws-sdk/client-sqs": "^3.1162.0",
    "@aws-sdk/lib-dynamodb": "^3.1162.0",
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/resilience": "0.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@osrs-tracker/express-metrics": "^0.2.0",
    "@osrs-tracker/hiscores": "^6.1.0",
    "@osrs-tracker/logger": "^0.3.0",
    "@osrs-tracker/models": "^3.4.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "isbot": "^5.2.2",
    "leven": "^4.1.0",
    "lru-cache": "^11.5.3",
    "mongodb": "^7.8.0",
    "nestjs-cls": "^7.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@rspack/core": "^2.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "multer": "^2.5.0"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
